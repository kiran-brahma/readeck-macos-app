# Build output
.build/
dist/
*.app

# App icon, derived from Resources/logo-square.svg by scripts/build-icon.sh
Resources/AppIcon.icns
Resources/AppIcon-1024.png

# The Readeck engine is fetched by scripts/build.sh and verified by SHA-256.
# Never committed: it is 65 MB, and its integrity must come from the pin.
vendor/

# Readeck runtime state. These live in ~/Library/Application Support/Readeck/ at
# runtime, but are listed here defensively in case the engine is ever run with
# this directory as its working directory.
#
# NEVER COMMIT ANY OF THESE. See README.md — "Never commit".
data/
backups/
logs/
config.toml
engine-version
server.json
.launcher.lock
db.sqlite3
db.sqlite3-wal
db.sqlite3-shm

# macOS
.DS_Store
